# Exemplo de ambiente do postaai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/postaai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

POSTAAI_ADMIN_KEY=
POSTAAI_CAKTO_SEGREDO=
POSTAAI_DEMO_SENHA=
POSTAAI_LLM_KEY=
POSTAAI_PN_TOKEN=
POSTAAI_SEGREDO_SESSAO=
POSTAAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
